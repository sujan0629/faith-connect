{
  "name": "faithconnect-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node -e \"require('fs').mkdirSync('backend/dist/shared',{recursive:true})\" && turbo run dev --parallel",
    "dev:backend": "pnpm --filter server dev",
    "dev:mobile": "pnpm --filter faithconnectapp dev",
    "dev:shared": "pnpm --filter @faithconnect/shared dev",
    "build": "turbo run build",
    "build:shared": "pnpm --filter @faithconnect/shared build",
    "lint": "turbo run lint",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
